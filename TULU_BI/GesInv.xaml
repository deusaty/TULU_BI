<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TULU_BI.GesInv"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto">

        <!-- Contenido principal con scroll -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="18" Padding="20,20,20,30">

                <!-- Barra Superior (Logo TULU BI) -->
                <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,5,0,0">
                    <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                        <Border StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40" StrokeThickness="0">
                            <Image Source="logo_tulu.png" Aspect="AspectFill" />
                        </Border>
                        <Label Text="TULU BI" 
                               TextColor="#0277BD" 
                               FontSize="20" 
                               FontAttributes="Bold" 
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    
                    <Border Grid.Column="2" 
                            BackgroundColor="#F8FAFC" 
                            StrokeShape="RoundRectangle 12" 
                            Padding="12,6" 
                            StrokeThickness="0"
                            VerticalOptions="Center">
                        <Label Text="🏷️ SERVICIOS" TextColor="#34D399" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Cabecera de la página -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Catálogo de Servicios" 
                           TextColor="#0F172A" 
                           FontSize="24" 
                           FontAttributes="Bold" />
                    <Label Text="Disponibilidad, tarifas oficiales y tiempos de entrega" 
                           TextColor="#475569" 
                           FontSize="13" />
                </VerticalStackLayout>

                <!-- Tarjetas KPI de Resumen -->
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">

                    <!-- KPI 1: Total Servicios -->
                    <Border Grid.Column="0" BackgroundColor="#F8FAFC" StrokeThickness="1" Stroke="#1F2937" Padding="12,14" StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="TOTAL" TextColor="#475569" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label x:Name="lblTotalServicios" Text="--" TextColor="#0F172A" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="Servicios" TextColor="#64748B" FontSize="10" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- KPI 2: Servicios Activos (Bolita Verde) -->
                    <Border Grid.Column="1" BackgroundColor="#F8FAFC" StrokeThickness="1" Stroke="#8BC34A" Padding="12,14" StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Border BackgroundColor="#8BC34A" StrokeShape="Ellipse" WidthRequest="7" HeightRequest="7" StrokeThickness="0" VerticalOptions="Center" />
                                <Label Text="ACTIVOS" TextColor="#34D399" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label x:Name="lblServiciosActivos" Text="--" TextColor="#0277BD" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="Disponibles" TextColor="#34D399" FontSize="10" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- KPI 3: Servicios Inactivos (Bolita Roja) -->
                    <Border Grid.Column="2" BackgroundColor="#F8FAFC" StrokeThickness="1" Stroke="#451A03" Padding="12,14" StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Border BackgroundColor="#EF4444" StrokeShape="Ellipse" WidthRequest="7" HeightRequest="7" StrokeThickness="0" VerticalOptions="Center" />
                                <Label Text="PAUSA" TextColor="#F87171" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label x:Name="lblServiciosInactivos" Text="--" TextColor="#EF4444" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="Inactivos" TextColor="#F87171" FontSize="10" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <!-- Barra de Búsqueda -->
                <Border BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#1F2937" Padding="14,2">
                    <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="🔍" FontSize="15" VerticalOptions="Center" Margin="0,0,8,0" />
                        <Entry Grid.Column="1" 
                               x:Name="txtBuscar" 
                               Placeholder="Buscar servicio (ej. edredón, tenis, secado...)" 
                               PlaceholderColor="#64748B" 
                               TextColor="#0F172A" 
                               FontSize="13"
                               TextChanged="OnBuscarTextChanged" 
                               BackgroundColor="Transparent" />
                    </Grid>
                </Border>

                <!-- Filtros Rápidos (Chips) -->
                <HorizontalStackLayout Spacing="8">
                    <!-- Chip Todos -->
                    <Border x:Name="chipTodos" 
                            BackgroundColor="#E8F5E9" 
                            StrokeShape="RoundRectangle 20" 
                            Padding="14,6" 
                            StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFiltroTodosTapped" />
                        </Border.GestureRecognizers>
                        <Label x:Name="lblChipTodos" Text="Todos" TextColor="#34D399" FontSize="12" FontAttributes="Bold" />
                    </Border>

                    <!-- Chip Activos (Verde) -->
                    <Border x:Name="chipActivos" 
                            BackgroundColor="#F8FAFC" 
                            StrokeShape="RoundRectangle 20" 
                            Padding="14,6" 
                            StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFiltroActivosTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Border BackgroundColor="#8BC34A" StrokeShape="Ellipse" WidthRequest="7" HeightRequest="7" StrokeThickness="0" VerticalOptions="Center" />
                            <Label x:Name="lblChipActivos" Text="Disponibles" TextColor="#475569" FontSize="12" FontAttributes="Bold" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Chip Inactivos (Rojo) -->
                    <Border x:Name="chipInactivos" 
                            BackgroundColor="#F8FAFC" 
                            StrokeShape="RoundRectangle 20" 
                            Padding="14,6" 
                            StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFiltroInactivosTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Border BackgroundColor="#EF4444" StrokeShape="Ellipse" WidthRequest="7" HeightRequest="7" StrokeThickness="0" VerticalOptions="Center" />
                            <Label x:Name="lblChipInactivos" Text="Inactivos" TextColor="#475569" FontSize="12" FontAttributes="Bold" />
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>

                <!-- Indicador de Carga -->
                <VerticalStackLayout x:Name="panelCargando" Spacing="8" HorizontalOptions="Center" Margin="0,15,0,15">
                    <ActivityIndicator IsRunning="True" Color="#8BC34A" WidthRequest="32" HeightRequest="32" />
                    <Label Text="Consultando catálogo en la base de datos..." TextColor="#475569" FontSize="12" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Lista de Servicios Dinámica -->
                <VerticalStackLayout x:Name="containerServicios" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#FFFFFF" 
                                    StrokeThickness="1" 
                                    Stroke="#E2E8F0" 
                                    Padding="16" 
                                    Margin="0,0,0,6"
                                    StrokeShape="RoundRectangle 16">
                                <Grid RowDefinitions="Auto, Auto" RowSpacing="16">
                                    
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" VerticalOptions="Center">

                                        <!-- Icono del servicio -->
                                        <Border Grid.Column="0" 
                                                BackgroundColor="#F1F5F9" 
                                                StrokeShape="RoundRectangle 14" 
                                                WidthRequest="54" 
                                                HeightRequest="54" 
                                                StrokeThickness="0" 
                                                VerticalOptions="Center">
                                            <Label Text="{Binding icono}" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>

                                        <!-- Datos: Nombre, ID y Tiempo Estimado -->
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                            <Label Text="{Binding descripcion_servicio}" 
                                                   TextColor="#0F172A" 
                                                   FontSize="15" 
                                                   FontAttributes="Bold" 
                                                   LineBreakMode="TailTruncation" 
                                                   MaxLines="2" />

                                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                <!-- ID Trabajo -->
                                                <Label Text="{Binding id_trabajo, StringFormat='#{0}'}" 
                                                       TextColor="#64748B" 
                                                       FontSize="12" 
                                                       VerticalTextAlignment="Center" />
                                                <Label Text="•" TextColor="#CBD5E1" FontSize="12" VerticalOptions="Center" />
                                                <!-- Tiempo estimado -->
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="⏱️" FontSize="10" VerticalOptions="Center" />
                                                    <Label Text="{Binding tiempo_formateado}" TextColor="#475569" FontSize="12" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- Lado Derecho: Precio y Bolita Verde/Roja con estado -->
                                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End" Spacing="6">
                                            <!-- Precio Actual -->
                                            <Label Text="{Binding precio_formateado}" 
                                                   TextColor="#0277BD" 
                                                   FontSize="16" 
                                                   FontAttributes="Bold" 
                                                   HorizontalOptions="End" />

                                            <!-- Bolita verde o roja -->
                                            <Border BackgroundColor="{Binding estado_bg}" 
                                                    StrokeShape="RoundRectangle 12" 
                                                    Padding="8,4" 
                                                    StrokeThickness="0" 
                                                    HorizontalOptions="End">
                                                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                                    <Border BackgroundColor="{Binding estado_color}" 
                                                            StrokeShape="Ellipse" 
                                                            WidthRequest="6" 
                                                            HeightRequest="6" 
                                                            StrokeThickness="0" 
                                                            VerticalOptions="Center" />
                                                    <Label Text="{Binding estado_texto}" 
                                                           TextColor="{Binding estado_text_color}" 
                                                           FontSize="10" 
                                                           FontAttributes="Bold" 
                                                           VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Botón Registrar Venta (Abajo, ancho completo) -->
                                    <Border Grid.Row="1" BackgroundColor="#E8F5E9" 
                                            StrokeShape="RoundRectangle 10" 
                                            Padding="0,10" 
                                            StrokeThickness="0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnVenderTapped" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="➕" FontSize="12" VerticalOptions="Center" />
                                            <Label Text="Registrar Venta" TextColor="#2E7D32" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Mensaje de sin resultados si aplica -->
                <VerticalStackLayout x:Name="panelSinResultados" IsVisible="False" Spacing="6" HorizontalOptions="Center" Margin="0,20,0,20">
                    <Label Text="🔎" FontSize="32" HorizontalOptions="Center" />
                    <Label Text="No se encontraron servicios coincidentes" TextColor="#475569" FontSize="13" HorizontalOptions="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Barra de Navegación Inferior (Servicios Activo) -->
        <Border Grid.Row="1" BackgroundColor="#F8FAFC" StrokeThickness="0" Padding="10,12" StrokeShape="RoundRectangle 24,24,0,0">
            <Grid ColumnDefinitions="*, *, *, *">

                <!-- Dashboard -->
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Fill" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDashboardTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="🏠" FontSize="16" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    <Label Text="DASHBOARD" TextColor="#475569" FontSize="9" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Servicios (Activo en esta página) -->
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Fill" VerticalOptions="Center">
                    <Border BackgroundColor="#E8F5E9" StrokeShape="RoundRectangle 10" WidthRequest="40" HeightRequest="26" StrokeThickness="0" HorizontalOptions="Center">
                        <Label Text="🧺" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="SERVICIOS" TextColor="#0277BD" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Operaciones -->
                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Fill" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAlertasTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="⚙️" FontSize="16" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    <Label Text="OPERAC." TextColor="#475569" FontSize="9" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Analítica -->
                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Fill" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAnaliticaTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="📊" FontSize="16" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    <Label Text="ANALÍTICA" TextColor="#475569" FontSize="9" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!--    MODAL: REGISTRAR VENTA                  -->
        <!-- ══════════════════════════════════════════ -->
        <Grid x:Name="modalRegistro" Grid.RowSpan="2" BackgroundColor="#CC000000" IsVisible="False">
            <Border BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 24,24,0,0" VerticalOptions="End" Padding="24" StrokeThickness="0">
                <VerticalStackLayout Spacing="20">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Registrar Nueva Venta" TextColor="#0F172A" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
                        <Border Grid.Column="1" BackgroundColor="#E1F5FE" StrokeShape="Ellipse" WidthRequest="32" HeightRequest="32" StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCerrarModalTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="✕" TextColor="#475569" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    
                    <Label x:Name="lblModalServicio" Text="Nombre del Servicio" TextColor="#0277BD" FontSize="16" FontAttributes="Bold" />
                    
                    <Border BackgroundColor="#E1F5FE" StrokeShape="RoundRectangle 12" Padding="14,8" StrokeThickness="0">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Seleccionar Cliente:" TextColor="#475569" FontSize="11" />
                            <Picker x:Name="pickerCliente" Title="Elige un cliente..." TextColor="#0F172A" TitleColor="#64748B" ItemDisplayBinding="{Binding nombre}" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*, *">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Tiempo Estimado" TextColor="#475569" FontSize="11" />
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="⏱️" FontSize="14" VerticalOptions="Center"/>
                                <Label x:Name="lblModalTiempo" Text="-- hrs" TextColor="#0F172A" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        
                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                            <Label Text="Total a Cobrar" TextColor="#475569" FontSize="11" HorizontalOptions="End" />
                            <Label x:Name="lblModalTotal" Text="$0.00" TextColor="#34D399" FontSize="22" FontAttributes="Bold" HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Estado y Método de Pago" TextColor="#475569" FontSize="12" Margin="0,10,0,0" FontAttributes="Bold"/>
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,5,0,10">
                        <Border Grid.Column="0" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="5,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Picker x:Name="pckEstadoPago" Title="Estado" TextColor="#0F172A" TitleColor="#94A3B8" FontSize="14" SelectedIndex="0">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Pagado</x:String>
                                        <x:String>Pendiente</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                        <Border Grid.Column="1" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="5,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Picker x:Name="pckMetodoPago" Title="Método" TextColor="#0F172A" TitleColor="#94A3B8" FontSize="14" SelectedIndex="0">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Efectivo</x:String>
                                        <x:String>Tarjeta</x:String>
                                        <x:String>Transferencia</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </Grid>

                    <Button x:Name="btnConfirmarVenta" Text="Confirmar Venta" BackgroundColor="#8BC34A" TextColor="#FFFFFF" FontSize="15" FontAttributes="Bold" CornerRadius="12" Margin="0,10,0,10" HeightRequest="50" Clicked="OnConfirmarVentaClicked" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
