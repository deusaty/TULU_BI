<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TULU_BI.GesInv"
             BackgroundColor="#070A13"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto">

        <!-- Contenido principal con scroll -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="18" Padding="20,20,20,30">

                <!-- Barra Superior (Logo TULU BI) -->
                <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,5,0,0">
                    <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                        <Border StrokeShape="Ellipse" WidthRequest="40" HeightRequest="40" StrokeThickness="0">
                            <Image Source="dotnet_bot.png" Aspect="AspectFill" />
                        </Border>
                        <Label Text="TULU BI" 
                               TextColor="#00E676" 
                               FontSize="20" 
                               FontAttributes="Bold" 
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    
                    <Border Grid.Column="2" 
                            BackgroundColor="#131B2E" 
                            StrokeShape="RoundRectangle 12" 
                            Padding="12,6" 
                            StrokeThickness="0"
                            VerticalOptions="Center">
                        <Label Text="🏷️ SERVICIOS" TextColor="#34D399" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Cabecera de la página -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Catálogo de Servicios" 
                           TextColor="White" 
                           FontSize="24" 
                           FontAttributes="Bold" />
                    <Label Text="Disponibilidad, tarifas oficiales y tiempos de entrega" 
                           TextColor="#9CA3AF" 
                           FontSize="13" />
                </VerticalStackLayout>

                <!-- Tarjetas KPI de Resumen -->
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">

                    <!-- KPI 1: Total Servicios -->
                    <Border Grid.Column="0" BackgroundColor="#131B2E" StrokeThickness="1" Stroke="#1F2937" Padding="12,14" StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="TOTAL" TextColor="#9CA3AF" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label x:Name="lblTotalServicios" Text="--" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="Servicios" TextColor="#64748B" FontSize="10" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- KPI 2: Servicios Activos (Bolita Verde) -->
                    <Border Grid.Column="1" BackgroundColor="#131B2E" StrokeThickness="1" Stroke="#064E3B" Padding="12,14" StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Border BackgroundColor="#00E676" StrokeShape="Ellipse" WidthRequest="7" HeightRequest="7" StrokeThickness="0" VerticalOptions="Center" />
                                <Label Text="ACTIVOS" TextColor="#34D399" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label x:Name="lblServiciosActivos" Text="--" TextColor="#00E676" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="Disponibles" TextColor="#34D399" FontSize="10" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- KPI 3: Servicios Inactivos (Bolita Roja) -->
                    <Border Grid.Column="2" BackgroundColor="#131B2E" StrokeThickness="1" Stroke="#451A03" Padding="12,14" StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Border BackgroundColor="#EF4444" StrokeShape="Ellipse" WidthRequest="7" HeightRequest="7" StrokeThickness="0" VerticalOptions="Center" />
                                <Label Text="PAUSA" TextColor="#F87171" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label x:Name="lblServiciosInactivos" Text="--" TextColor="#EF4444" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="Inactivos" TextColor="#F87171" FontSize="10" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <!-- Barra de Búsqueda -->
                <Border BackgroundColor="#131B2E" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#1F2937" Padding="14,2">
                    <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="🔍" FontSize="15" VerticalOptions="Center" Margin="0,0,8,0" />
                        <Entry Grid.Column="1" 
                               x:Name="txtBuscar" 
                               Placeholder="Buscar servicio (ej. edredón, tenis, secado...)" 
                               PlaceholderColor="#64748B" 
                               TextColor="White" 
                               FontSize="13"
                               TextChanged="OnBuscarTextChanged" 
                               BackgroundColor="Transparent" />
                    </Grid>
                </Border>

                <!-- Filtros Rápidos (Chips) -->
                <HorizontalStackLayout Spacing="8">
                    <!-- Chip Todos -->
                    <Border x:Name="chipTodos" 
                            BackgroundColor="#064E3B" 
                            StrokeShape="RoundRectangle 20" 
                            Padding="14,6" 
                            StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFiltroTodosTapped" />
                        </Border.GestureRecognizers>
                        <Label x:Name="lblChipTodos" Text="Todos" TextColor="#34D399" FontSize="12" FontAttributes="Bold" />
                    </Border>

                    <!-- Chip Activos (Verde) -->
                    <Border x:Name="chipActivos" 
                            BackgroundColor="#131B2E" 
                            StrokeShape="RoundRectangle 20" 
                            Padding="14,6" 
                            StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFiltroActivosTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Border BackgroundColor="#00E676" StrokeShape="Ellipse" WidthRequest="7" HeightRequest="7" StrokeThickness="0" VerticalOptions="Center" />
                            <Label x:Name="lblChipActivos" Text="Disponibles" TextColor="#9CA3AF" FontSize="12" FontAttributes="Bold" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Chip Inactivos (Rojo) -->
                    <Border x:Name="chipInactivos" 
                            BackgroundColor="#131B2E" 
                            StrokeShape="RoundRectangle 20" 
                            Padding="14,6" 
                            StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFiltroInactivosTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Border BackgroundColor="#EF4444" StrokeShape="Ellipse" WidthRequest="7" HeightRequest="7" StrokeThickness="0" VerticalOptions="Center" />
                            <Label x:Name="lblChipInactivos" Text="Inactivos" TextColor="#9CA3AF" FontSize="12" FontAttributes="Bold" />
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>

                <!-- Indicador de Carga -->
                <VerticalStackLayout x:Name="panelCargando" Spacing="8" HorizontalOptions="Center" Margin="0,15,0,15">
                    <ActivityIndicator IsRunning="True" Color="#00E676" WidthRequest="32" HeightRequest="32" />
                    <Label Text="Consultando catálogo en la base de datos..." TextColor="#9CA3AF" FontSize="12" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Lista de Servicios Dinámica -->
                <VerticalStackLayout x:Name="containerServicios" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#131B2E" 
                                    StrokeThickness="1" 
                                    Stroke="#1E293B" 
                                    Padding="14,12" 
                                    StrokeShape="RoundRectangle 16">
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">

                                    <!-- Icono del servicio -->
                                    <Border Grid.Column="0" 
                                            BackgroundColor="#0B1120" 
                                            StrokeShape="RoundRectangle 12" 
                                            WidthRequest="46" 
                                            HeightRequest="46" 
                                            StrokeThickness="0" 
                                            VerticalOptions="Center">
                                        <Label Text="{Binding icono}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>

                                    <!-- Datos: Nombre, ID y Tiempo Estimado -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                        <Label Text="{Binding descripcion_servicio}" 
                                               TextColor="White" 
                                               FontSize="14" 
                                               FontAttributes="Bold" 
                                               LineBreakMode="TailTruncation" 
                                               MaxLines="2" />

                                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                            <!-- Tiempo estimado badge -->
                                            <Border BackgroundColor="#1E293B" 
                                                    StrokeShape="RoundRectangle 6" 
                                                    Padding="6,2" 
                                                    StrokeThickness="0">
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="⏱️" FontSize="9" VerticalOptions="Center" />
                                                    <Label Text="{Binding tiempo_formateado}" TextColor="#94A3B8" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </Border>

                                            <!-- ID Trabajo -->
                                            <Label Text="{Binding id_trabajo, StringFormat='#{0}'}" 
                                                   TextColor="#64748B" 
                                                   FontSize="11" 
                                                   VerticalTextAlignment="Center" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- Lado Derecho: Precio y Bolita Verde/Roja con estado -->
                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End" Spacing="4">
                                        <!-- Precio Actual -->
                                        <Label Text="{Binding precio_formateado}" 
                                               TextColor="White" 
                                               FontSize="15" 
                                               FontAttributes="Bold" 
                                               HorizontalOptions="End" />

                                        <!-- Bolita verde o roja solicitada por el usuario -->
                                        <Border BackgroundColor="{Binding estado_bg}" 
                                                StrokeShape="RoundRectangle 12" 
                                                Padding="8,3" 
                                                StrokeThickness="0" 
                                                HorizontalOptions="End">
                                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                                <!-- Bolita indicadora Verde o Roja -->
                                                <Border BackgroundColor="{Binding estado_color}" 
                                                        StrokeShape="Ellipse" 
                                                        WidthRequest="8" 
                                                        HeightRequest="8" 
                                                        StrokeThickness="0" 
                                                        VerticalOptions="Center" />
                                                <!-- Texto Estado -->
                                                <Label Text="{Binding estado_texto}" 
                                                       TextColor="{Binding estado_text_color}" 
                                                       FontSize="11" 
                                                       FontAttributes="Bold" 
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </VerticalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Mensaje de sin resultados si aplica -->
                <VerticalStackLayout x:Name="panelSinResultados" IsVisible="False" Spacing="6" HorizontalOptions="Center" Margin="0,20,0,20">
                    <Label Text="🔎" FontSize="32" HorizontalOptions="Center" />
                    <Label Text="No se encontraron servicios coincidentes" TextColor="#9CA3AF" FontSize="13" HorizontalOptions="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Barra de Navegación Inferior (Servicios Activo) -->
        <Border Grid.Row="1" BackgroundColor="#131B2E" StrokeThickness="0" Padding="10,12" StrokeShape="RoundRectangle 24,24,0,0">
            <Grid ColumnDefinitions="*, *, *, *">

                <!-- Dashboard -->
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDashboardTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="❖" FontSize="16" HorizontalOptions="Center" />
                    <Label Text="DASHBOARD" TextColor="#9CA3AF" FontSize="9" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Servicios (Activo en esta página) -->
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                    <Border BackgroundColor="#064E3B" StrokeShape="RoundRectangle 10" WidthRequest="40" HeightRequest="26" StrokeThickness="0" HorizontalOptions="Center">
                        <Label Text="🧺" TextColor="#00E676" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="SERVICIOS" TextColor="#00E676" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Operaciones -->
                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAlertasTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="⚙️" FontSize="16" HorizontalOptions="Center" />
                    <Label Text="OPERAC." TextColor="#9CA3AF" FontSize="9" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Analítica -->
                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAnaliticaTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="📊" FontSize="16" HorizontalOptions="Center" />
                    <Label Text="ANALÍTICA" TextColor="#9CA3AF" FontSize="9" HorizontalOptions="Center" />
                </VerticalStackLayout>

            </Grid>
        </Border>

    </Grid>
</ContentPage>