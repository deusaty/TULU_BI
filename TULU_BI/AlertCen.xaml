<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TULU_BI.AlertCen"
             BackgroundColor="#070A13"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto">

        <!-- Contenido principal con scroll -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="20" Padding="20,20,20,30">

                <!-- Barra Superior (Perfil, Título y Notificaciones) -->
                <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,5,0,5">
                    <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                        <Border StrokeShape="Ellipse" WidthRequest="42" HeightRequest="42" StrokeThickness="0">
                            <Image Source="dotnet_bot.png" Aspect="AspectFill" />
                        </Border>
                        <Label Text="TULU BI" 
                               TextColor="#00E676" 
                               FontSize="20" 
                               FontAttributes="Bold" 
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>

                    <Border Grid.Column="2" 
                            BackgroundColor="#131B2E" 
                            StrokeShape="Ellipse" 
                            WidthRequest="42" 
                            HeightRequest="42" 
                            StrokeThickness="0"
                            HorizontalOptions="End" 
                            VerticalOptions="Center">
                        <Label Text="🔔" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Cabecera de la página -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Centro de Acción" 
                           TextColor="White" 
                           FontSize="22" 
                           FontAttributes="Bold" />
                    <Label Text="Gestión de protocolos operativos y resoluciones pendientes." 
                           TextColor="#9CA3AF" 
                           FontSize="14" />
                </VerticalStackLayout>

                <!-- Pestañas de Estado (Pendientes, Ejecutados, Archivados) -->
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto, Auto, Auto" ColumnSpacing="24" Margin="0,5,0,0">
                        <VerticalStackLayout Grid.Column="0" Spacing="8">
                            <Label Text="PENDIENTES (3)" TextColor="#00E676" FontSize="12" FontAttributes="Bold" />
                            <BoxView HeightRequest="2" BackgroundColor="#00E676" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="EJECUTADOS" TextColor="#9CA3AF" FontSize="12" FontAttributes="Bold" VerticalTextAlignment="Center" />
                        <Label Grid.Column="2" Text="ARCHIVADOS" TextColor="#9CA3AF" FontSize="12" FontAttributes="Bold" VerticalTextAlignment="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#1F2937" Margin="0,0,0,5" />
                </VerticalStackLayout>

                <!-- Tarjeta 1: Alerta Alta (Intervención de Cliente Moroso) -->
                <Border BackgroundColor="#131B2E" StrokeThickness="0" Padding="18" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="12">
                        <!-- Cabecera de la tarjeta: Badge y ID -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Border Grid.Column="0" BackgroundColor="#451A03" StrokeShape="RoundRectangle 8" Padding="10,4" StrokeThickness="0" HorizontalOptions="Start">
                                <HorizontalStackLayout Spacing="6">
                                    <Ellipse WidthRequest="6" HeightRequest="6" Fill="#F87171" VerticalOptions="Center" />
                                    <Label Text="ALERTA ALTA" TextColor="#F87171" FontSize="10" FontAttributes="Bold" VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Label Grid.Column="1" Text="ID: TK-9482" TextColor="#9CA3AF" FontSize="12" VerticalTextAlignment="Center" />
                        </Grid>

                        <!-- Título y Descripción -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Intervención de Cliente Moroso" TextColor="White" FontSize="16" FontAttributes="Bold" />
                            <Label Text="Factura vencida hace 45 días. Requiere contacto inmediato para reestructuración de pago o suspensión de servicio." TextColor="#9CA3AF" FontSize="12" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="#1F2937" Margin="0,2" />

                        <!-- Pie de tarjeta: Tiempo y Botón Gestionar (Resaltado en Verde) -->
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                <Label Text="🕒" FontSize="12" VerticalTextAlignment="Center" />
                                <Label Text="Hace 2 hrs" TextColor="#9CA3AF" FontSize="12" VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#064E3B" StrokeShape="RoundRectangle 10" Padding="14,8" StrokeThickness="0">
                                <Label Text="GESTIONAR" TextColor="#34D399" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Tarjeta 2: Bloqueo (Liberación de Anaquel) -->
                <Border BackgroundColor="#131B2E" StrokeThickness="0" Padding="18" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Border Grid.Column="0" BackgroundColor="#1F2937" StrokeShape="RoundRectangle 8" Padding="10,4" StrokeThickness="0" HorizontalOptions="Start">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="🔒" FontSize="10" VerticalTextAlignment="Center" />
                                    <Label Text="BLOQUEO > 8 DÍAS" TextColor="#9CA3AF" FontSize="10" FontAttributes="Bold" VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Label Grid.Column="1" Text="ID: TK-9475" TextColor="#9CA3AF" FontSize="12" VerticalTextAlignment="Center" />
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Liberación de Anaquel" TextColor="White" FontSize="16" FontAttributes="Bold" />
                            <Label Text="Prendas sin recoger en Anaquel B-42. Iniciar protocolo de donación/almacenamiento profundo según términos." TextColor="#9CA3AF" FontSize="12" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="#1F2937" Margin="0,2" />

                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                <Label Text="🕒" FontSize="12" VerticalTextAlignment="Center" />
                                <Label Text="Hace 1 día" TextColor="#9CA3AF" FontSize="12" VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#1F2937" StrokeShape="RoundRectangle 10" Padding="14,8" StrokeThickness="0">
                                <Label Text="GESTIONAR" TextColor="#9CA3AF" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Tarjeta 3: Riesgo de Fuga (Retención de Clientes) -->
                <Border BackgroundColor="#131B2E" StrokeThickness="0" Padding="18" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Border Grid.Column="0" BackgroundColor="#064E3B" StrokeShape="RoundRectangle 8" Padding="10,4" StrokeThickness="0" HorizontalOptions="Start">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="📉" FontSize="10" VerticalTextAlignment="Center" />
                                    <Label Text="RIESGO DE FUGA" TextColor="#34D399" FontSize="10" FontAttributes="Bold" VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                            </Border>
                            <Label Grid.Column="1" Text="ID: TK-9460" TextColor="#9CA3AF" FontSize="12" VerticalTextAlignment="Center" />
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Retención de Clientes" TextColor="White" FontSize="16" FontAttributes="Bold" />
                            <Label Text="Cliente VIP (ID: 8839) muestra caída del 60% en frecuencia de uso en el último trimestre. Aplicar oferta de reactivación." TextColor="#9CA3AF" FontSize="12" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="#1F2937" Margin="0,2" />

                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                <Label Text="🕒" FontSize="12" VerticalTextAlignment="Center" />
                                <Label Text="Hace 2 días" TextColor="#9CA3AF" FontSize="12" VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#1F2937" StrokeShape="RoundRectangle 10" Padding="14,8" StrokeThickness="0">
                                <Label Text="GESTIONAR" TextColor="#9CA3AF" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Barra de Navegación Inferior (Alertas Activo) -->
        <Border Grid.Row="1" BackgroundColor="#131B2E" StrokeThickness="0" Padding="10,12" StrokeShape="RoundRectangle 24,24,0,0">
            <Grid ColumnDefinitions="*, *, *, *">

                <!-- Dashboard -->
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDashboardTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="❖" FontSize="16" HorizontalOptions="Center" />
                    <Label Text="DASHBOARD" TextColor="#9CA3AF" FontSize="9" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Servicios -->
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInventarioTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="🧺" FontSize="16" HorizontalOptions="Center" />
                    <Label Text="SERVICIOS" TextColor="#9CA3AF" FontSize="9" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Alertas (Activo en esta página) -->
                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAlertasTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Border BackgroundColor="#064E3B" StrokeShape="RoundRectangle 10" WidthRequest="40" HeightRequest="26" StrokeThickness="0" HorizontalOptions="Center">
                        <Label Text="🔔" TextColor="#00E676" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="ALERTAS" TextColor="#00E676" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Analítica -->
                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAnaliticaTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="📊" FontSize="16" HorizontalOptions="Center" />
                    <Label Text="ANALÍTICA" TextColor="#9CA3AF" FontSize="9" HorizontalOptions="Center" />
                </VerticalStackLayout>

            </Grid>
        </Border>

    </Grid>
</ContentPage>