<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="TULU_BI.AnaliticRen"
             BackgroundColor="#070A13"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto">

        <!-- Contenido principal con scroll -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="20" Padding="20,20,20,30">

                <!-- Barra Superior (Perfil, Título y Notificaciones) -->
                <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,5,0,5">
                    <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                        <Label Text="TULU BI" 
                               TextColor="#00E676" 
                               FontSize="20" 
                               FontAttributes="Bold" 
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Grid.Column="2" Spacing="10" HorizontalOptions="End" VerticalOptions="Center">
                        <Border BackgroundColor="#131B2E" StrokeShape="Ellipse" WidthRequest="40" HeightRequest="40" StrokeThickness="0">
                            <Label Text="🔔" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border StrokeShape="Ellipse" WidthRequest="40" HeightRequest="40" StrokeThickness="0">
                            <Image Source="dotnet_bot.png" Aspect="AspectFill" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Cabecera de la página -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Analítica de Rendimiento" 
                           TextColor="White" 
                           FontSize="22" 
                           FontAttributes="Bold" />
                    <Label Text="Métricas operativas en tiempo real e inteligencia predictiva para instalaciones de lavandería de alto volumen." 
                           TextColor="#9CA3AF" 
                           FontSize="13" 
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- Tarjeta 1: Total de Clientes (KPI) -->
                <Border BackgroundColor="#131B2E" StrokeThickness="0" Padding="20" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="TOTAL DE CLIENTES REGISTRADOS" TextColor="#9CA3AF" FontSize="11" FontAttributes="Bold" />
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label x:Name="lblTotalClientes" Text="Cargando..." TextColor="White" FontSize="32" FontAttributes="Bold" />
                            <Border BackgroundColor="#064E3B" StrokeShape="RoundRectangle 12" Padding="10,4" StrokeThickness="0" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="👥" FontSize="11" VerticalOptions="Center" />
                                    <Label Text="Activos" TextColor="#34D399" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Tarjeta 3: Completitud de Perfiles (Gráfico) -->
                <Border BackgroundColor="#131B2E" StrokeThickness="0" Padding="20" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="COMPLETITUD DE PERFILES DE CLIENTES" TextColor="#9CA3AF" FontSize="11" FontAttributes="Bold" />

                        <!-- Gráfico de barras de Microcharts -->
                        <VerticalStackLayout HorizontalOptions="FillAndExpand" Spacing="4" Padding="0,10">
                            <microcharts:ChartView x:Name="chartDistribucion" HeightRequest="200" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Barra de Navegación Inferior (Analítica Activa) -->
        <Border Grid.Row="1" BackgroundColor="#131B2E" StrokeThickness="0" Padding="10,12" StrokeShape="RoundRectangle 24,24,0,0">
            <Grid ColumnDefinitions="*, *, *, *">

                <!-- Dashboard -->
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDashboardTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="❖" FontSize="16" HorizontalOptions="Center" />
                    <Label Text="DASHBOARD" TextColor="#9CA3AF" FontSize="9" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Inventario -->
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInventarioTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="📦" FontSize="16" HorizontalOptions="Center" />
                    <Label Text="INVENTARIO" TextColor="#9CA3AF" FontSize="9" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Alertas -->
                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAlertasTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="🔔" FontSize="16" HorizontalOptions="Center" />
                    <Label Text="ALERTAS" TextColor="#9CA3AF" FontSize="9" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Analítica (Activo en esta página) -->
                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAnaliticaTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Border BackgroundColor="#064E3B" StrokeShape="RoundRectangle 10" WidthRequest="40" HeightRequest="26" StrokeThickness="0" HorizontalOptions="Center">
                        <Label Text="📊" TextColor="#00E676" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="ANALÍTICA" TextColor="#00E676" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>

            </Grid>
        </Border>

    </Grid>
</ContentPage>