<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TULU_BI.MainPage"
             BackgroundColor="#070A13"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto">

        <!-- ══════════════════════════════════════════ -->
        <!--           CONTENIDO PRINCIPAL              -->
        <!-- ══════════════════════════════════════════ -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,24">

                <!-- ─────────────────────────────── -->
                <!--   HEADER DEGRADADO (Hero Banner) -->
                <!-- ─────────────────────────────── -->
                <Border BackgroundColor="#0D1526" Padding="20,24,20,28" StrokeThickness="0">
                    <VerticalStackLayout Spacing="14">

                        <!-- Fila: Logo + Fecha/Hora -->
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <!-- Logo TULU BI -->
                            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                <Border BackgroundColor="#00E676" StrokeShape="RoundRectangle 8" WidthRequest="34" HeightRequest="34" StrokeThickness="0">
                                    <Label Text="T" TextColor="#070A13" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="TULU BI" TextColor="#00E676" FontSize="18" FontAttributes="Bold" VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>

                            <!-- Fecha y hora en vivo -->
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center" Spacing="1">
                                <Label x:Name="lblFecha" Text="domingo, 7 sep" TextColor="#94A3B8" FontSize="11" HorizontalOptions="End" />
                                <Label x:Name="lblHora" Text="16:30" TextColor="#E2E8F0" FontSize="13" FontAttributes="Bold" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Saludo al empleado -->
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="👋" FontSize="24" VerticalOptions="Center" />
                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                    <Label x:Name="lblSaludo" Text="¡Buenos días!" TextColor="#9CA3AF" FontSize="13" />
                                    <Label x:Name="lblNombreEmpleado" Text="Cargando..." TextColor="White" FontSize="22" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                                <Border x:Name="borderRol" BackgroundColor="#0F2A1A" StrokeShape="RoundRectangle 20" Padding="10,4" StrokeThickness="0">
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Border BackgroundColor="#00E676" StrokeShape="Ellipse" WidthRequest="6" HeightRequest="6" StrokeThickness="0" VerticalOptions="Center" />
                                        <Label x:Name="lblRol" Text="Turno Activo" TextColor="#34D399" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Label x:Name="lblTurno" Text="• Lavandería TULU" TextColor="#64748B" FontSize="12" VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- ─────────────────────────────── -->
                <!--   KPIs PRINCIPALES (4 tarjetas) -->
                <!-- ─────────────────────────────── -->
                <VerticalStackLayout Padding="16,18,16,0" Spacing="0">

                    <Label Text="Resumen del Negocio" TextColor="White" FontSize="16" FontAttributes="Bold" Margin="0,0,0,12" />

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="10">

                        <!-- KPI 1: Ingresos Totales -->
                        <Border Grid.Row="0" Grid.Column="0"
                                BackgroundColor="#131B2E"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="1" Stroke="#1E293B"
                                Padding="14,16">
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Border BackgroundColor="#064E3B" StrokeShape="RoundRectangle 8" WidthRequest="28" HeightRequest="28" StrokeThickness="0">
                                        <Label Text="💰" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="INGRESOS" TextColor="#9CA3AF" FontSize="9" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label x:Name="lblTotalVentas" Text="$--" TextColor="White" FontSize="20" FontAttributes="Bold" />
                                <Label x:Name="lblTotalVentasSubtitle" Text="-- ventas registradas" TextColor="#64748B" FontSize="10" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- KPI 2: Clientes Activos -->
                        <Border Grid.Row="0" Grid.Column="1"
                                BackgroundColor="#131B2E"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="1" Stroke="#1E293B"
                                Padding="14,16">
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Border BackgroundColor="#1E3A5F" StrokeShape="RoundRectangle 8" WidthRequest="28" HeightRequest="28" StrokeThickness="0">
                                        <Label Text="👥" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="CLIENTES" TextColor="#9CA3AF" FontSize="9" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label x:Name="lblTotalClientes" Text="--" TextColor="White" FontSize="20" FontAttributes="Bold" />
                                <Label x:Name="lblClientesActivos" Text="-- activos" TextColor="#64748B" FontSize="10" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- KPI 3: Órdenes Pagadas -->
                        <Border Grid.Row="1" Grid.Column="0"
                                BackgroundColor="#131B2E"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="1" Stroke="#1E293B"
                                Padding="14,16">
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Border BackgroundColor="#064E3B" StrokeShape="RoundRectangle 8" WidthRequest="28" HeightRequest="28" StrokeThickness="0">
                                        <Label Text="✅" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="PAGADAS" TextColor="#9CA3AF" FontSize="9" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label x:Name="lblOrdenesPagadas" Text="--" TextColor="#00E676" FontSize="20" FontAttributes="Bold" />
                                <Label x:Name="lblOrdenesPagadasSubtitle" Text="órdenes completadas" TextColor="#64748B" FontSize="10" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- KPI 4: Órdenes Pendientes -->
                        <Border Grid.Row="1" Grid.Column="1"
                                BackgroundColor="#131B2E"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="1" Stroke="#1E293B"
                                Padding="14,16">
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Border BackgroundColor="#3B1515" StrokeShape="RoundRectangle 8" WidthRequest="28" HeightRequest="28" StrokeThickness="0">
                                        <Label Text="⏳" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="PENDIENTES" TextColor="#9CA3AF" FontSize="9" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label x:Name="lblOrdenesPendientes" Text="--" TextColor="#F87171" FontSize="20" FontAttributes="Bold" />
                                <Label x:Name="lblOrdenesPendientesSubtitle" Text="por cobrar" TextColor="#64748B" FontSize="10" />
                            </VerticalStackLayout>
                        </Border>

                    </Grid>
                </VerticalStackLayout>

                <!-- ─────────────────────────────────── -->
                <!--   MÉTODOS DE PAGO (Barra visual)   -->
                <!-- ─────────────────────────────────── -->
                <VerticalStackLayout Padding="16,20,16,0" Spacing="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="💳  Métodos de Pago" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalTextAlignment="Center" />
                        <Label Grid.Column="1" x:Name="lblTotalTransacciones" Text="-- transacciones" TextColor="#64748B" FontSize="11" VerticalTextAlignment="Center" />
                    </Grid>

                    <Border BackgroundColor="#131B2E" StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#1E293B" Padding="16,14">
                        <VerticalStackLayout Spacing="12">

                            <!-- Efectivo -->
                            <VerticalStackLayout Spacing="5">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                        <Label Text="💵" FontSize="14" VerticalOptions="Center" />
                                        <Label Text="Efectivo" TextColor="#E2E8F0" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label x:Name="lblEfectivoCount" Grid.Column="2" Text="-- ventas" TextColor="#94A3B8" FontSize="12" VerticalOptions="Center" />
                                </Grid>
                                <ProgressBar x:Name="pbEfectivo" Progress="0" ProgressColor="#00E676" HeightRequest="6" BackgroundColor="#1E293B" />
                            </VerticalStackLayout>

                            <!-- Tarjeta -->
                            <VerticalStackLayout Spacing="5">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                        <Label Text="💳" FontSize="14" VerticalOptions="Center" />
                                        <Label Text="Tarjeta" TextColor="#E2E8F0" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label x:Name="lblTarjetaCount" Grid.Column="2" Text="-- ventas" TextColor="#94A3B8" FontSize="12" VerticalOptions="Center" />
                                </Grid>
                                <ProgressBar x:Name="pbTarjeta" Progress="0" ProgressColor="#3B82F6" HeightRequest="6" BackgroundColor="#1E293B" />
                            </VerticalStackLayout>

                            <!-- Transferencia -->
                            <VerticalStackLayout Spacing="5">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                        <Label Text="📱" FontSize="14" VerticalOptions="Center" />
                                        <Label Text="Transferencia" TextColor="#E2E8F0" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label x:Name="lblTransferenciaCount" Grid.Column="2" Text="-- ventas" TextColor="#94A3B8" FontSize="12" VerticalOptions="Center" />
                                </Grid>
                                <ProgressBar x:Name="pbTransferencia" Progress="0" ProgressColor="#A78BFA" HeightRequest="6" BackgroundColor="#1E293B" />
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ─────────────────────────────────── -->
                <!--   TOP SERVICIOS MÁS VENDIDOS       -->
                <!-- ─────────────────────────────────── -->
                <VerticalStackLayout Padding="16,20,16,0" Spacing="10">
                    <Label Text="🏆  Top Servicios" TextColor="White" FontSize="15" FontAttributes="Bold" />

                    <!-- Servicio #1 -->
                    <Border x:Name="cardTop1" BackgroundColor="#131B2E" StrokeShape="RoundRectangle 14" StrokeThickness="1" Stroke="#064E3B" Padding="14,12">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" BackgroundColor="#064E3B" StrokeShape="RoundRectangle 10" WidthRequest="40" HeightRequest="40" StrokeThickness="0" VerticalOptions="Center">
                                <Label Text="🥇" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label x:Name="lblTop1Nombre" Text="—" TextColor="White" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="1" />
                                <Label x:Name="lblTop1Sub" Text="—" TextColor="#64748B" FontSize="11" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End" Spacing="2">
                                <Label x:Name="lblTop1Precio" Text="—" TextColor="#00E676" FontSize="14" FontAttributes="Bold" HorizontalOptions="End" />
                                <Label Text="por kg/pieza" TextColor="#64748B" FontSize="10" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Servicio #2 -->
                    <Border x:Name="cardTop2" BackgroundColor="#131B2E" StrokeShape="RoundRectangle 14" StrokeThickness="1" Stroke="#1E293B" Padding="14,12">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 10" WidthRequest="40" HeightRequest="40" StrokeThickness="0" VerticalOptions="Center">
                                <Label Text="🥈" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label x:Name="lblTop2Nombre" Text="—" TextColor="White" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="1" />
                                <Label x:Name="lblTop2Sub" Text="—" TextColor="#64748B" FontSize="11" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End" Spacing="2">
                                <Label x:Name="lblTop2Precio" Text="—" TextColor="#94A3B8" FontSize="14" FontAttributes="Bold" HorizontalOptions="End" />
                                <Label Text="por kg/pieza" TextColor="#64748B" FontSize="10" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Servicio #3 -->
                    <Border x:Name="cardTop3" BackgroundColor="#131B2E" StrokeShape="RoundRectangle 14" StrokeThickness="1" Stroke="#1E293B" Padding="14,12">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 10" WidthRequest="40" HeightRequest="40" StrokeThickness="0" VerticalOptions="Center">
                                <Label Text="🥉" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label x:Name="lblTop3Nombre" Text="—" TextColor="White" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="1" />
                                <Label x:Name="lblTop3Sub" Text="—" TextColor="#64748B" FontSize="11" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End" Spacing="2">
                                <Label x:Name="lblTop3Precio" Text="—" TextColor="#94A3B8" FontSize="14" FontAttributes="Bold" HorizontalOptions="End" />
                                <Label Text="por kg/pieza" TextColor="#64748B" FontSize="10" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- ─────────────────────────────────── -->
                <!--   ACCESOS RÁPIDOS DEL TURNO        -->
                <!-- ─────────────────────────────────── -->
                <VerticalStackLayout Padding="16,20,16,0" Spacing="10">
                    <Label Text="⚡  Accesos Rápidos" TextColor="White" FontSize="15" FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">

                        <!-- Ir a Servicios -->
                        <Border Grid.Column="0" BackgroundColor="#131B2E" StrokeShape="RoundRectangle 14" StrokeThickness="1" Stroke="#1E293B" Padding="0,14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnInventarioTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="🧺" FontSize="24" HorizontalOptions="Center" />
                                <Label Text="Servicios" TextColor="#94A3B8" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Ir a Analítica -->
                        <Border Grid.Column="1" BackgroundColor="#131B2E" StrokeShape="RoundRectangle 14" StrokeThickness="1" Stroke="#1E293B" Padding="0,14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAnaliticaTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="📊" FontSize="24" HorizontalOptions="Center" />
                                <Label Text="Analítica" TextColor="#94A3B8" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Ir a Alertas -->
                        <Border Grid.Column="2" BackgroundColor="#131B2E" StrokeShape="RoundRectangle 14" StrokeThickness="1" Stroke="#1E293B" Padding="0,14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAlertasTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="🔔" FontSize="24" HorizontalOptions="Center" />
                                <Label Text="Alertas" TextColor="#94A3B8" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                    </Grid>
                </VerticalStackLayout>

                <!-- ─────────────────────────────────── -->
                <!--   INDICADOR DE CARGA               -->
                <!-- ─────────────────────────────────── -->
                <VerticalStackLayout x:Name="panelCargando" Spacing="6" HorizontalOptions="Center" Margin="0,20,0,0" IsVisible="True">
                    <ActivityIndicator IsRunning="True" Color="#00E676" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" />
                    <Label Text="Actualizando datos..." TextColor="#64748B" FontSize="12" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- ─────────────────────────────────── -->
                <!--   FOOTER: EMPLEADOS DEL EQUIPO     -->
                <!-- ─────────────────────────────────── -->
                <VerticalStackLayout Padding="16,20,16,0" Spacing="10">
                    <Label Text="🏢  Equipo de Turno" TextColor="White" FontSize="15" FontAttributes="Bold" />
                    <Border BackgroundColor="#131B2E" StrokeShape="RoundRectangle 14" StrokeThickness="1" Stroke="#1E293B" Padding="14,12">
                        <VerticalStackLayout x:Name="containerEmpleados" Spacing="10" />
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ══════════════════════════════════════════ -->
        <!--       BARRA DE NAVEGACIÓN INFERIOR        -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="1" BackgroundColor="#131B2E" StrokeThickness="0" Padding="10,12" StrokeShape="RoundRectangle 24,24,0,0">
            <Grid ColumnDefinitions="*, *, *, *">

                <!-- Dashboard (Activo) -->
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                    <Border BackgroundColor="#064E3B" StrokeShape="RoundRectangle 10" WidthRequest="40" HeightRequest="26" StrokeThickness="0" HorizontalOptions="Center">
                        <Label Text="❖" TextColor="#00E676" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="DASHBOARD" TextColor="#00E676" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Servicios -->
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInventarioTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="🧺" FontSize="16" HorizontalOptions="Center" />
                    <Label Text="SERVICIOS" TextColor="#9CA3AF" FontSize="9" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Alertas -->
                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAlertasTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="🔔" FontSize="16" HorizontalOptions="Center" />
                    <Label Text="ALERTAS" TextColor="#9CA3AF" FontSize="9" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Analítica -->
                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAnaliticaTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="📊" FontSize="16" HorizontalOptions="Center" />
                    <Label Text="ANALÍTICA" TextColor="#9CA3AF" FontSize="9" HorizontalOptions="Center" />
                </VerticalStackLayout>

            </Grid>
        </Border>

    </Grid>
</ContentPage>
